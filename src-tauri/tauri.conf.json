{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeplerV",
  "version": "0.1.0",
  "identifier": "com.keplerv.intent-browser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "KeplerV \u00b7 Your workspace",
        "width": 1440,
        "height": 940,
        "minWidth": 900,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; frame-src 'self' https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "runtime-bundle": "runtime-bundle"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A workspace for goals and guided work",
    "longDescription": "Keep goals, work, and supporting resources together in one guided workspace.",
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
